# TSR Travel Backend - Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# Application
PROJECT_NAME=TSR TRAVEL API
API_V1_STR=/api
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# Database (use PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./tsr_travel.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/tsrtravel

# CORS - Add your Vercel frontend URL here in production
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# Redis (optional - remove if not using)
# REDIS_URL=redis://localhost:6379/0

# Cloudinary (optional - for image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# File uploads
UPLOAD_DIR=uploads
